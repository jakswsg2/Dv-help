# ===============================================================
#  DV-Prep .dockerignore — keep the build context small & clean
# ===============================================================

# Dependencies & build output (rebuilt inside the image)
node_modules
dist
build

# Environment & secrets (never bake into the image)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Git & tooling
.git
.gitignore
.github
.vscode
.idea
*.swp
*.swo

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Docker, CI & docs (not needed inside the image)
Dockerfile
.dockerignore
docker-compose*.yml
.github
README.md
