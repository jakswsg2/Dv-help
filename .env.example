# ==============================================================================
# DV-Prep — Environment Variables Template (.env.example)
# ==============================================================================
# DV-Prep is a self-contained Vite + React SPA. It talks directly to Firebase
# (Firestore / Auth) from the browser, so the only configuration needed is the
# Firebase project credentials, provided at build time via firebase-applet-config.json.
#
# Docker deployment needs no .env at all — just:
#   docker compose up --build
# The optional variables below only affect the container's exposed port.
# ==============================================================================

# ----- Docker (optional) -----
# Host port the container is published on (default: 8080).
APP_PORT=8080
# Image name/tag for the production compose file (docker-compose.prod.yml).
APP_IMAGE=dv-prep
TAG=latest
# ----- Firebase (client-side, build-time) -----
# The real values live in firebase-applet-config.json at the repository root,
# which Vite reads and bundles into the client. Do NOT put secrets here.
VITE_APP_TITLE=DV-Prep
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
