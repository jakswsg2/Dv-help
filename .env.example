# ==============================================================================
# DV-Prep — Environment Variables Template (.env.example)
# ==============================================================================

# Application Metadata
PROJECT_NAME=DV-Prep
APP_ENV=production
ENV=production
DEBUG=false
PRODUCTION_URL=
API_V1_PREFIX=/api/v1
GITHUB_REPOSITORY=sdfsws/Dv-help

# Administrator Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS Settings (JSON Array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Native HestiaCP PostgreSQL Database Configuration (Local Instance)
# Standard local loopback (127.0.0.1) connecting to Hestia-managed PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=admin_dvhelp
DB_NAME=admin_dvhelp
POSTGRES_USER=admin_dvhelp
DB_USER=admin_dvhelp
POSTGRES_PASSWORD=
DB_PASSWORD=

# Standard Local Database Connection Strings
# Async SQLAlchemy (FastAPI / asyncpg):
DATABASE_URL=postgresql+asyncpg://admin_dvhelp:YOUR_PASSWORD@127.0.0.1:5432/admin_dvhelp
# Sync SQLAlchemy / Psycopg2:
DATABASE_SYNC_URL=postgresql://admin_dvhelp:YOUR_PASSWORD@127.0.0.1:5432/admin_dvhelp
# Standard libpq URI / DSN:
POSTGRES_DSN=postgresql://admin_dvhelp:YOUR_PASSWORD@127.0.0.1:5432/admin_dvhelp?sslmode=prefer

# Native Redis Cache & Background Queue (Local System Service)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0

# Storage Configuration (Native Filesystem Directory on HestiaCP Host)
STORAGE_TYPE=local
UPLOAD_DIR=/home/admin/web/dv.example.com/uploads
# Optional S3 / External Storage Fallback (Leave blank for local filesystem)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# Authentication & JWT Security
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Symmetric Data Encryption (AES-256-GCM 64-char Hex Key)
ENCRYPTION_KEY=

# Frontend & Vite Client-Side Config
NEXT_PUBLIC_API_URL=/api/v1
VITE_APP_TITLE=DV-Prep
VITE_APP_ENV=production
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
