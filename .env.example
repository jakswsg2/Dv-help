# ==============================================================================
# DV-Prep — Environment Variables Template (.env.example)
# ==============================================================================

# Application Metadata
PROJECT_NAME=DV-Prep
APP_ENV=production
ENV=production
DEBUG=false
PRODUCTION_URL=
API_V1_PREFIX=/api/v1
GITHUB_REPOSITORY=sdfsws/Dv-help

# Administrator Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS Settings (JSON Array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dvprep_db
DB_NAME=dvprep_db
POSTGRES_USER=dvprep_user
DB_USER=dvprep_user
POSTGRES_PASSWORD=
DB_PASSWORD=
DATABASE_URL=

# Redis Cache & Background Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=dvprepadmin
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=dvprep-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000

# Authentication & JWT Security
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Symmetric Data Encryption (AES-256-GCM 64-char Hex Key)
ENCRYPTION_KEY=

# Frontend & Vite Client-Side Config
NEXT_PUBLIC_API_URL=/api/v1
VITE_APP_TITLE=DV-Prep
VITE_APP_ENV=production
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
