# ================================================================
#  DV-Prep — Caddyfile (Automatic HTTPS via Let's Encrypt)
#  استبدل yourdomain.com باسم النطاق الخاص بك
# ================================================================

# ---- Main Application (Frontend) ----
dvprep.yourdomain.com {
    # Serve Next.js frontend
    reverse_proxy frontend:3000

    # Security Headers (OWASP recommended)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.dvprep.yourdomain.com; worker-src blob:;"
        Permissions-Policy "camera=self, microphone=()"
        -Server
    }

    # Gzip compression
    encode gzip

    # Logging
    log {
        output file /var/log/caddy/frontend.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

# ---- API Backend ----
api.dvprep.yourdomain.com {
    # Forward all /api/* to FastAPI
    reverse_proxy backend:8000

    # CORS handled by FastAPI — no duplicate headers here

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        -Server
    }

    # Rate limiting (برمجي — يمكن تفعيل caddy-ratelimit plugin)
    # limit_except GET POST PUT PATCH DELETE OPTIONS {
    #     deny all
    # }

    encode gzip

    log {
        output file /var/log/caddy/api.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

